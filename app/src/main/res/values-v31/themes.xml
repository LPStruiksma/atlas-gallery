<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- BRAND-L3 (#656): API 31+ uses the platform splash screen: Lapis ground in light and
         dark, the static launcher foreground mark centred (its 0.77-scaled mark stays inside the
         platform's 192 dp icon circle), no icon background, no branding image, no animation.
         windowBackground stays the platform theme's, so the window after launch is unchanged. -->
    <style name="Theme.Atlas.Launch" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/atlas_lapis</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
