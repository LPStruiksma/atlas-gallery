<?xml version="1.0" encoding="utf-8"?>
<!-- BRAND-L3 (#656): Lapis Atlas held-sphere mark, full colour: white mark on the Lapis ground.
     Source geometry on the 108 dp canvas: sphere centre (54,40) r 15; chevron M30 84L54 60L78 84,
     stroke 8, round caps and joins. The whole mark, strokes included, is scaled by 0.77 about the
     centre (54,54): the farthest stroked point is (sqrt(24^2+30^2)+4) x 0.77 = 32.66 dp from the
     centre, inside the r 33 adaptive-icon safe circle. Static: no animation. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.77"
        android:scaleY="0.77">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M54,40m-15,0a15,15 0,1 1,30 0a15,15 0,1 1,-30 0" />
        <path
            android:pathData="M30,84L54,60L78,84"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
