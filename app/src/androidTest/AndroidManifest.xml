<?xml version="1.0" encoding="utf-8"?>
<!--
  androidTest APK only (package nl.atlas.gallery.test); nothing here ships in ATLAS.
  Two input methods for emulator tests, chosen per test by KeyboardRule:
  a fixed-height keyboard panel and a keyboard that never appears.
  See docs/testing/EMULATOR_TESTS.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="nl.atlas.gallery.testkit.UsageShareTargetActivity"
            android:exported="true"
            android:label="Test recipient">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
        <activity
            android:name="nl.atlas.gallery.testkit.UsageShareTargetActivityB"
            android:exported="true"
            android:label="Test recipient two">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
        <service
            android:name="nl.atlas.gallery.testkit.AtlasTestKeyboard"
            android:exported="true"
            android:label="ATLAS test keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/atlas_test_keyboard" />
        </service>
        <service
            android:name="nl.atlas.gallery.testkit.AtlasNoKeyboard"
            android:exported="true"
            android:label="ATLAS no keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/atlas_test_keyboard" />
        </service>
    </application>
</manifest>
